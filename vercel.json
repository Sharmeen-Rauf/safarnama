{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/api/auth/register", "dest": "/api/register.php" },
    { "src": "/api/auth/login", "dest": "/api/login.php" },
    { "src": "/api/auth/logout", "dest": "/api/logout.php" },
    { "src": "/api/user/profile", "dest": "/api/profile.php" },
    { "src": "/api/user/me", "dest": "/api/profile.php" },
    { "src": "/login", "dest": "/api/login-page.php" },
    { "src": "/login.php", "dest": "/api/login-page.php" },
    { "src": "/register", "dest": "/api/register-page.php" },
    { "src": "/register.php", "dest": "/api/register-page.php" },
    { "src": "/farmer-dashboard.php", "dest": "/api/farmer-dashboard-page.php" },
    { "src": "/buyer-dashboard.php", "dest": "/api/buyer-dashboard-page.php" },
    { "src": "/edit-profile.php", "dest": "/api/edit-profile-page.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/", "dest": "/api/index.php" }
  ]
}
